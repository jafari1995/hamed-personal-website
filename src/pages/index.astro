---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { site } from "../site.config";
import {
  getPosts,
  getCategories,
  categoryHref,
} from "../lib/posts";

const posts = await getPosts();
const categories = await getCategories();
const featured = posts[0];
const rest = posts.slice(1, 9);
const primaryCat = categories[0];
---
<BaseLayout title={site.name} description={site.tagline} language={site.language} direction={site.direction}>
  <section class="home-hero">
    <div class="home-hero-copy">
      <p class="section-label">Practical guides</p>
      <h1>{site.name}</h1>
      <p class="lede">{site.tagline}</p>
      <div class="hero-actions">
        {featured && (
          <a class="btn-primary" href={`/${featured.slug}/`}>Read latest guide</a>
        )}
        {primaryCat && (
          <a class="btn-ghost" href={categoryHref(primaryCat.id)}>Browse {primaryCat.label}</a>
        )}
      </div>
    </div>
    {featured ? (
      <PostCard post={featured} featured />
    ) : (
      <div class="empty">Guides will appear here as they are published.</div>
    )}
  </section>

  {categories.length > 0 && (
    <section class="section" aria-label="Topics">
      <div class="section-head">
        <h2>Browse by topic</h2>
      </div>
      <div class="topic-strip">
        {categories.map((cat) => (
          <div class="topic-link">
            <a href={categoryHref(cat.id)} style="text-decoration:none;color:inherit">
              <strong>{cat.label}</strong>
              <span>{cat.count} guide{cat.count === 1 ? "" : "s"}</span>
            </a>
            {cat.subcategories.length > 0 && (
              <ul>
                {cat.subcategories.slice(0, 4).map((sub) => (
                  <li>
                    <a href={categoryHref(cat.id, sub.id)}>
                      {sub.label}
                      <span class="muted"> ({sub.count})</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="section" aria-label="Latest guides">
    <div class="section-head">
      <h2>More guides</h2>
      {posts.length > 9 && <a href={primaryCat ? categoryHref(primaryCat.id) : "/"}>See all topics</a>}
    </div>
    {rest.length === 0 && posts.length <= 1 ? (
      <p class="muted">More articles will show up here as you publish.</p>
    ) : (
      <div class="story-grid cols-2">
        {rest.map((post) => <PostCard post={post} />)}
      </div>
    )}
  </section>

  <aside class="trust-strip">
    <h2>Why this site exists</h2>
    <p>{site.about}</p>
  </aside>
</BaseLayout>
